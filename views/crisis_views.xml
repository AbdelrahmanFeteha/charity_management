<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_charity_crisis_list" model="ir.ui.view">
        <field name="name">charity.crisis.list</field>
        <field name="model">charity.crisis</field>
        <field name="arch" type="xml">
            <list string="Crises">
                <field name="name"/>
                <field name="country"/>
                <field name="category"/>
                <field name="severity"/>
                <field name="status"/>
                <field name="last_update"/>
                <field name="project_id"/>
            </list>
        </field>
    </record>

    <record id="view_charity_crisis_form" model="ir.ui.view">
        <field name="name">charity.crisis.form</field>
        <field name="model">charity.crisis</field>
        <field name="arch" type="xml">
            <form string="Crisis">
                <header>
                    <!-- No attrs/states in Odoo 17 -->
                    <button name="action_create_project" type="object"
                            string="Create Project" class="btn-primary"/>
                    <button name="action_load_sample_data" type="object"
                            string="Load Sample Data" class="oe_highlight"/>
                    <field name="status" widget="statusbar" statusbar_visible="active,monitor,resolved"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="country"/>
                        <field name="category"/>
                        <field name="severity"/>
                        <field name="last_update"/>
                        <field name="url"/>
                        <field name="project_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="summary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_charity_crisis" model="ir.actions.act_window">
        <field name="name">Crises</field>
        <field name="res_model">charity.crisis</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
