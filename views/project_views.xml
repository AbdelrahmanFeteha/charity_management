<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List -->
    <record id="view_charity_project_list" model="ir.ui.view">
        <field name="name">charity.project.list</field>
        <field name="model">charity.project</field>
        <field name="arch" type="xml">
            <list string="Projects / Campaigns">
                <field name="name"/>
                <field name="category"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="total_requested"/>
                <field name="total_donations"/>
                <field name="total_distributed"/>
                <field name="funding_progress"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_charity_project_form" model="ir.ui.view">
        <field name="name">charity.project.form</field>
        <field name="model">charity.project</field>
        <field name="arch" type="xml">
            <form string="Project / Campaign">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="funding_progress" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Requests">
                            <field name="request_ids">
                                <list editable="bottom">
                                    <field name="requester_name"/>
                                    <field name="category"/>
                                    <field name="amount_requested"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>

                        <page string="Donations">
                            <field name="donation_ids">
                                <list editable="bottom">
                                    <field name="donor_id"/>
                                    <field name="amount"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>

                        <page string="Distributions">
                            <field name="distribution_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="request_id"/>
                                    <field name="donation_id"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="action_charity_project" model="ir.actions.act_window">
        <field name="name">Projects / Campaigns</field>
        <field name="res_model">charity.project</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
