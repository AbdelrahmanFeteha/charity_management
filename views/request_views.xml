<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List -->
    <record id="view_charity_request_list" model="ir.ui.view">
        <field name="name">charity.request.list</field>
        <field name="model">charity.request</field>
        <field name="arch" type="xml">
            <list string="Help Requests" decoration-success="status == 'funded'"
                  decoration-warning="status == 'pending'" decoration-danger="status == 'rejected'">
                <field name="requester_name"/>
                <field name="project_id"/>
                <field name="category"/>
                <field name="amount_requested"/>
                <field name="amount_funded"/>
                <field name="funding_progress"/>
                <field name="status"/>
                <field name="date_requested"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_charity_request_form" model="ir.ui.view">
        <field name="name">charity.request.form</field>
        <field name="model">charity.request</field>
        <field name="arch" type="xml">
            <form string="Help Request">
                <sheet>
                    <group>
                        <group>
                            <field name="requester_name"/>
                            <field name="location"/>
                            <field name="category"/>
                            <field name="project_id" options="{'no_create_edit': False}"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="amount_requested"/>
                            <field name="amount_funded" readonly="1"/>
                            <field name="funding_progress" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Distributions">
                            <field name="distribution_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="project_id" readonly="1"/>
                                    <field name="donation_id"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

