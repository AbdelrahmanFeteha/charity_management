<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_charity_distribution_list" model="ir.ui.view">
        <field name="name">charity.distribution.list</field>
        <field name="model">charity.distribution</field>
        <field name="arch" type="xml">
            <list string="Distributions">
                <field name="date"/>
                <field name="project_id"/>
                <field name="request_id"/>
                <field name="donation_id"/>
                <field name="amount"/>
            </list>
        </field>
    </record>

    <record id="view_charity_distribution_form" model="ir.ui.view">
        <field name="name">charity.distribution.form</field>
        <field name="model">charity.distribution</field>
        <field name="arch" type="xml">
            <form string="Distribution">
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="project_id"/>
                        <field name="request_id"/>
                        <field name="donation_id"/>
                        <field name="amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

