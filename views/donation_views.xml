<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List -->
    <record id="view_charity_donation_list" model="ir.ui.view">
        <field name="name">charity.donation.list</field>
        <field name="model">charity.donation</field>
        <field name="arch" type="xml">
            <list string="Donations">
                <field name="donor_id"/>
                <field name="project_id"/>
                <field name="amount"/>
                <field name="status"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_charity_donation_form" model="ir.ui.view">
        <field name="name">charity.donation.form</field>
        <field name="model">charity.donation</field>
        <field name="arch" type="xml">
            <form string="Donation">
                <sheet>
                    <group>
                        <group>
                            <field name="donor_id" options="{'no_create_edit': False}"/>
                            <field name="amount"/>
                            <field name="currency"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="date"/>
                            <field name="organization"/>
                            <field name="is_anonymous"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Optional note..."/>
                    </group>
                    <notebook>
                        <page string="Distributions">
                            <field name="distribution_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="request_id"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_charity_donation" model="ir.actions.act_window">
        <field name="name">Donations</field>
        <field name="res_model">charity.donation</field>
        <field name="view_mode">list,graph,form</field>
    </record>

    <record id="view_charity_donation_graph" model="ir.ui.view">
    <field name="name">charity.donation.graph</field>
    <field name="model">charity.donation</field>
    <field name="arch" type="xml">
        <graph string="Donations by Project" type="pie">
            <!-- Each slice = project -->
            <field name="project_id" type="row"/>
            <!-- Donation amount = size of slice -->
            <field name="amount" type="measure"/>
        </graph>
    </field>
</record>


</odoo>